{
  "name": "rich-telegram-ads",
  "version": "1.1.0",
  "description": "Chrome extension that adds bulk targeting, automatic ad splitting, and bulk ad actions to ads.telegram.org",
  "author": "Alireza Akhtari",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "pnpm build && node scripts/zip.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
