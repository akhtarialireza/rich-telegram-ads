{
  "name": "Rich Telegram Ads",
  "description": "Extension that adds bulk targeting, automatic ad splitting, and bulk ad actions to ads.telegram.org",
  "version": "1.0.1",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": ["https://ads.telegram.org/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
